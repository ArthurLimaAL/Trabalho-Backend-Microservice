# CONFIGURAÇÕES DO SERVIÇO DE JWT
# Copie este arquivo para .env e altere os valores.

# Porta do servidor
PORT=3000

# --- Segredos JWT (Obrigatório) ---
# Use chaves fortes e diferentes em produção
JWT_SECRET=sua-chave-secreta-aqui
JWT_REFRESH_SECRET=sua-chave-de-refresh-aqui

# --- Validade dos Tokens ---
JWT_EXPIRES_IN=15m          # Token de acesso (ex: 15 minutos)
JWT_REFRESH_EXPIRES_IN=7d   # Token de atualização (ex: 7 dias)

# --- Segurança de Login ---
MAX_LOGIN_ATTEMPTS=5        # Tentativas máximas antes de bloquear
LOGIN_LOCKOUT_MINUTES=15    # Tempo de bloqueio em minutos